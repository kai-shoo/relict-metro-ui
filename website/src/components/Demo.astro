---
import Code from './Code.astro';
interface Props { code: string; title?: string }
const { code, title = 'Live example' } = Astro.props;
---
<section class="demo" aria-label={title}>
  <div class="demo-label"><span class="status-dot"></span>{title}</div>
  <div class="demo-stage"><slot /></div>
  <Code code={code} />
</section>
