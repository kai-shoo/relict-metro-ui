---
import Demo from './Demo.astro';
import { componentExample } from '../lib/component-catalog';

interface Props { tag: string }
const { tag } = Astro.props;
const { title, code, srcdoc, app } = componentExample(tag, Astro.site!);
---
<Demo title={title} code={code}>
  <noscript>Enable JavaScript to try this example. The code is available below.</noscript>
  <iframe title={`${tag}: ${title}`} srcdoc={srcdoc}></iframe>
</Demo>
{app && <a class="text-link" href={app} data-astro-reload>Open the full application example →</a>}

<style>
  iframe { width: 100%; height: clamp(14rem, 45dvh, 26rem); border: 0; }
</style>
