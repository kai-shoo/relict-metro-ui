---
import Docs from '../../layouts/Docs.astro';
import { documents } from '../../lib/content';
export function getStaticPaths() {
  return documents.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = entry.document;
---
<Docs title={entry.title} headings={entry.headings}>
  <div class="eyebrow">DOCUMENTATION / REFERENCE</div>
  <article class="prose markdown-document"><Content /></article>
</Docs>
