---
import Docs from '../layouts/Docs.astro';
import { withBase } from '../lib/paths';
const examples = [
  { name: 'Mail', path: 'mail/', icon: 'mail', text: 'Switch folders and open a message.', color: '#0050ef' },
  { name: 'Start screen', path: 'start/', icon: 'pin', text: 'Open the inbox or flagged mail from a pinned tile.', color: '#a20025' },
  { name: 'Settings', path: 'controls/', icon: 'settings', text: 'Set a delivery preference and save the form.', color: '#008272' },
  { name: 'Workspace', path: 'workspace/', icon: 'edit', text: 'Edit project notes and move a notebook to another window.', color: '#6a00ff' },
  { name: 'Media library', path: 'media/', icon: 'play', text: 'Play a recording and create a notification.', color: '#b61861' },
  { name: 'Collections', path: 'collections/', icon: 'folder', text: 'Select recordings and transfer them to a queue.', color: '#a65300' },
  { name: 'Component catalog', path: 'catalog/?tag=metro-repeat-button', icon: 'search', text: 'Try a repeat button, inspect its source, or choose another component.', color: '#34495e' },
];
---
<Docs title="Example apps" wide>
  <div class="eyebrow">DOCUMENTATION / IN PRACTICE</div>
  <h1>example apps<span class="accent">.</span></h1>
  <p class="lead">Open a standalone app to see how Metro components work together. Use the component catalog to explore individual controls.</p>
  <div class="examples-grid">
    {examples.map((example) => <a class="example-card" href={withBase(`/examples/${example.path}`)} data-astro-reload>
      <metro-tile size="wide" aria-hidden="true" style={`--metro-tile-bg: ${example.color}`}>
        <metro-icon name={example.icon}></metro-icon>
      </metro-tile>
      <h2>{example.name}</h2>
      <p>{example.text}</p>
    </a>)}
  </div>
</Docs>

<style>
  .example-card metro-tile { --metro-tile-width: 100%; --metro-tile-fg: white; }
  .example-card metro-icon { font-size: 2.5rem; }
  .example-card h2 { font-size: 1.4rem; margin: .75rem 0 0; }
</style>
