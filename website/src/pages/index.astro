---
import Docs from '../layouts/Docs.astro';
import Code from '../components/Code.astro';
import { tags } from '../lib/content';
import { withBase } from '../lib/paths';
---
<Docs title="Documentation" wide>
  <section class="hero">
    <div>
      <div class="eyebrow">Developer guide / Overview</div>
      <h1>Relict<br /><span class="accent">Metro UI</span></h1>
      <p class="lead">Build Windows Phone–inspired interfaces with Web Components. Start with a single control or explore a complete app.</p>
      <div class="hero-actions">
        <a class="primary-link" href={withBase('/getting-started/')}>Get started <span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-install"><code>npm install relict-metro-ui</code><metro-button data-copy="npm install relict-metro-ui" label="Copy install command">Copy</metro-button><span class="copy-status sr-only" role="status"></span></div>
    </div>
    <nav class="tile-composition" aria-label="Explore the library">
      <metro-tile label="Component catalog" href={withBase('/components/')} class="count-tile"><span class="tile-number">{tags.length}</span></metro-tile>
      <metro-tile label="Icon catalog" href={withBase('/icons/')} class="type-tile"><metro-icon name="favorite"></metro-icon></metro-tile>
      <metro-tile label="Example apps" href={withBase('/examples/')} size="wide" class="wide-tile"><span class="tile-word">apps →</span></metro-tile>
    </nav>
  </section>
  <section class="home-section">
    <div class="section-heading"><div><div class="eyebrow">01 / Playground</div><h2>Try the controls</h2></div><a href={withBase('/components/')} class="text-link">All components →</a></div>
    <div class="showcase-grid">
      <section class="showcase-card">
        <a class="card-caption" href={withBase('/components/button/')}><span>Actions</span><code>metro-button →</code></a>
        <div class="showcase-controls"><metro-button id="hello-button">Hello, Metro</metro-button><output id="hello-output" aria-live="polite">Give it a click</output></div>
      </section>
      <section class="showcase-card">
        <a class="card-caption" href={withBase('/components/toggle-switch/')}><span>State</span><code>metro-toggle-switch →</code></a>
        <div class="showcase-controls"><metro-toggle-switch checked on-label="On" off-label="Off">Notifications</metro-toggle-switch></div>
      </section>
      <section class="showcase-card">
        <a class="card-caption" href={withBase('/components/slider/')}><span>Input</span><code>metro-slider →</code></a>
        <div class="showcase-controls"><metro-slider label="Volume" min="0" max="100" value="65" show-bounds></metro-slider></div>
      </section>
    </div>
  </section>
  <section class="home-section start-section">
    <div><div class="eyebrow">02 / First steps</div><h2>Add a button</h2><p class="muted">Import the button module in a browser script. Then add its tag to your page.</p><a class="text-link" href={withBase('/getting-started/')}>Read the installation guide →</a></div>
    <Code code={`<script>\n  import 'relict-metro-ui/button';\n</script>\n\n<metro-button>\n  Hello, Metro\n</metro-button>`} label="Inside an Astro component" />
  </section>
  <section class="home-section">
    <div class="section-heading"><div><div class="eyebrow">03 / Guides</div><h2>Build your interface</h2></div></div>
    <div class="guide-grid">
      <a href={withBase('/reference/foundations/')}><h3>Themes →</h3><p>Set colors, type, and spacing with CSS custom properties.</p></a>
      <a href={withBase('/reference/api/')}><h3>Component API →</h3><p>Look up attributes, properties, slots, and events.</p></a>
      <a href={withBase('/examples/')}><h3>Example apps →</h3><p>See how the components work together in complete interfaces.</p></a>
    </div>
  </section>
</Docs>
