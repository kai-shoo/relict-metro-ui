---
import Docs from '../layouts/Docs.astro';
import Code from '../components/Code.astro';
import { tags } from '../lib/content';
import { withBase } from '../lib/paths';
---
<Docs title="Documentation" wide>
  <div class="eyebrow"><span class="status-dot"></span> FAMILIAR DESIGN. NEW POSSIBILITIES.</div>
  <section class="hero">
    <div>
      <h1>less chrome.<br />more <span class="accent">meaning.</span></h1>
      <p class="lead">Metro, reimagined for the web. Expressive typography, live tiles, and {tags.length} components for interfaces with character.</p>
      <div class="hero-actions">
        <a class="primary-link" href={withBase('/getting-started/')}>Get started <span>↗</span></a>
        <a class="text-link" href={withBase('/components/')}>Explore components →</a>
      </div>
      <div class="hero-install"><code>npm install relict-metro-ui</code><metro-button data-copy="npm install relict-metro-ui" label="Copy install command">copy</metro-button><span class="copy-status sr-only" role="status"></span></div>
    </div>
    <div class="tile-composition" aria-label="Metro UI tile examples">
      <metro-tile label="components" href={withBase('/components/')} class="count-tile"><span class="tile-number">{tags.length}</span></metro-tile>
      <metro-tile label="typography" href={withBase('/reference/foundations/')} class="type-tile"><span class="tile-type">Aa</span></metro-tile>
      <metro-tile label="room for your ideas" href={withBase('/examples/')} size="wide" class="wide-tile"><span class="tile-word">hello, metro.</span></metro-tile>
      <div class="composition-caption">01 / an interface that speaks for itself</div>
    </div>
  </section>
  <div class="fact-strip"><span><b>{tags.length}</b> custom elements</span><span><b>0</b> framework lock-in</span><span><b>2</b> color themes</span><span><b>∞</b> combinations</span></div>
  <section class="home-section">
    <div class="section-heading"><div><div class="eyebrow">A LIVING UI KIT</div><h2>already in motion.</h2></div><a href={withBase('/components/')} class="text-link">Full catalog ↗</a></div>
    <div class="showcase-grid">
      <section class="showcase-card">
        <div class="card-caption"><span>01 / actions</span><code>metro-button</code></div>
        <div class="showcase-controls"><metro-button id="hello-button">Hello, Metro</metro-button><output id="hello-output" aria-live="polite">Give it a click</output></div>
      </section>
      <section class="showcase-card">
        <div class="card-caption"><span>02 / state</span><code>metro-toggle-switch</code></div>
        <div class="showcase-controls"><metro-toggle-switch checked on-label="On" off-label="Off">Notifications</metro-toggle-switch></div>
      </section>
      <section class="showcase-card">
        <div class="card-caption"><span>03 / feedback</span><code>metro-slider</code></div>
        <div class="showcase-controls"><metro-slider label="Volume" min="0" max="100" value="65" show-bounds></metro-slider></div>
      </section>
    </div>
  </section>
  <section class="home-section start-section">
    <div><div class="eyebrow">SIMPLER THAN YOU THINK</div><h2>ordinary HTML.<br />extraordinary interfaces.</h2><p class="muted">Import a component and use it like any HTML element. Events, properties, and CSS — everything you already know.</p><a class="text-link" href={withBase('/getting-started/')}>From install to your first screen →</a></div>
    <Code code={`<script>\n  import 'relict-metro-ui/button';\n</script>\n\n<metro-button>\n  Hello, Metro\n</metro-button>`} label="Inside an Astro component" />
  </section>
  <section class="guide-grid home-section">
    <a href={withBase('/reference/foundations/')}><span>01</span><h3>Make it yours</h3><p>Color, typography, and space. Shape your interface with CSS design tokens.</p><b>Customize →</b></a>
    <a href={withBase('/reference/api/')}><span>02</span><h3>A clear contract</h3><p>Attributes, properties, slots, and events. Everything you need to work with the components.</p><b>Open the API →</b></a>
    <a href={withBase('/examples/')}><span>03</span><h3>Complete apps</h3><p>Mail, settings, and a workspace. See how the pieces come together.</p><b>Explore →</b></a>
  </section>
</Docs>
